   <dc:creator>
    <rdf:Seq>
     <rdf:li>Karol Wieczorek and Daniel Kaczmarski</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Detecting AI-Generated Text and Assessing Citation Integrity in Scholarly Communication: A Scoping Review of Methods</rdf:li>
     <rdf:li xml:lang="en-US">Detecting AI-Generated Text and Assessing Citation Integrity in Scholarly Communication: A Scoping Review of Methods</rdf:li>
     <rdf:li xml:lang="x-default">Limitations</rdf:li>
     <rdf:li xml:lang="en-US">Limitations</rdf:li>
     <rdf:li xml:lang="x-default">and Manipulation</rdf:li>
     <rdf:li xml:lang="en-US">and Manipulation</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>[-15]AI-generated text; large language models; citation integrity; reference hallucination; stylometry; bibliometric manipulation; scoping review; PRISMA-ScR</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Large language models complicate text-origin assessment and increase risks from nonexistent</rdf:li>
     <rdf:li xml:lang="en-US">Large language models complicate text-origin assessment and increase risks from nonexistent</rdf:li>
     <rdf:li xml:lang="x-default">inaccurate</rdf:li>
     <rdf:li xml:lang="en-US">inaccurate</rdf:li>
     <rdf:li xml:lang="x-default">or strategically used citations. This scoping review maps methods for detecting AI-generated or substantially AI-modified text and for evaluating reference integrity and citation manipulation in scholarly communication. We searched Scopus and Web of Science Core Collection on 31 August 2026</rdf:li>
     <rdf:li xml:lang="en-US">or strategically used citations. This scoping review maps methods for detecting AI-generated or substantially AI-modified text and for evaluating reference integrity and citation manipulation in scholarly communication. We searched Scopus and Web of Science Core Collection on 31 August 2026</rdf:li>
     <rdf:li xml:lang="x-default">and IEEE Xplore on 2 September 2026. Four thematic search streams yielded 1633 records after filters. Following deduplication</rdf:li>
     <rdf:li xml:lang="en-US">and IEEE Xplore on 2 September 2026. Four thematic search streams yielded 1633 records after filters. Following deduplication</rdf:li>
     <rdf:li xml:lang="x-default">removal of five 2027 records</rdf:li>
     <rdf:li xml:lang="en-US">removal of five 2027 records</rdf:li>
     <rdf:li xml:lang="x-default">citation searching</rdf:li>
     <rdf:li xml:lang="en-US">citation searching</rdf:li>
     <rdf:li xml:lang="x-default">title-and-abstract screening</rdf:li>
     <rdf:li xml:lang="en-US">title-and-abstract screening</rdf:li>
     <rdf:li xml:lang="x-default">and full-text assessment</rdf:li>
     <rdf:li xml:lang="en-US">and full-text assessment</rdf:li>
     <rdf:li xml:lang="x-default">71 peer-reviewed publications were retained; 69 formed the main synthesis and two provided conceptual background. Detection approaches included statistical signals</rdf:li>
     <rdf:li xml:lang="en-US">71 peer-reviewed publications were retained; 69 formed the main synthesis and two provided conceptual background. Detection approaches included statistical signals</rdf:li>
     <rdf:li xml:lang="x-default">conventional machine learning</rdf:li>
     <rdf:li xml:lang="en-US">conventional machine learning</rdf:li>
     <rdf:li xml:lang="x-default">transformer classifiers</rdf:li>
     <rdf:li xml:lang="en-US">transformer classifiers</rdf:li>
     <rdf:li xml:lang="x-default">stylometry</rdf:li>
     <rdf:li xml:lang="en-US">stylometry</rdf:li>
     <rdf:li xml:lang="x-default">watermarking</rdf:li>
     <rdf:li xml:lang="en-US">watermarking</rdf:li>
     <rdf:li xml:lang="x-default">retrieval</rdf:li>
     <rdf:li xml:lang="en-US">retrieval</rdf:li>
     <rdf:li xml:lang="x-default">and process-based provenance. Performance varied across generators</rdf:li>
     <rdf:li xml:lang="en-US">and process-based provenance. Performance varied across generators</rdf:li>
     <rdf:li xml:lang="x-default">domains</rdf:li>
     <rdf:li xml:lang="en-US">domains</rdf:li>
     <rdf:li xml:lang="x-default">languages</rdf:li>
     <rdf:li xml:lang="en-US">languages</rdf:li>
     <rdf:li xml:lang="x-default">text lengths</rdf:li>
     <rdf:li xml:lang="en-US">text lengths</rdf:li>
     <rdf:li xml:lang="x-default">paraphrases</rdf:li>
     <rdf:li xml:lang="en-US">paraphrases</rdf:li>
     <rdf:li xml:lang="x-default">and mixed human--AI texts</rdf:li>
     <rdf:li xml:lang="en-US">and mixed human--AI texts</rdf:li>
     <rdf:li xml:lang="x-default">limiting the evidentiary value of a single detector score. Citation-integrity studies addressed fabricated or inaccurate references</rdf:li>
     <rdf:li xml:lang="en-US">limiting the evidentiary value of a single detector score. Citation-integrity studies addressed fabricated or inaccurate references</rdf:li>
     <rdf:li xml:lang="x-default">claim--source agreement</rdf:li>
     <rdf:li xml:lang="en-US">claim--source agreement</rdf:li>
     <rdf:li xml:lang="x-default">citation function</rdf:li>
     <rdf:li xml:lang="en-US">citation function</rdf:li>
     <rdf:li xml:lang="x-default">coercion</rdf:li>
     <rdf:li xml:lang="en-US">coercion</rdf:li>
     <rdf:li xml:lang="x-default">cartels</rdf:li>
     <rdf:li xml:lang="en-US">cartels</rdf:li>
     <rdf:li xml:lang="x-default">stacking</rdf:li>
     <rdf:li xml:lang="en-US">stacking</rdf:li>
     <rdf:li xml:lang="x-default">self-citation</rdf:li>
     <rdf:li xml:lang="en-US">self-citation</rdf:li>
     <rdf:li xml:lang="x-default">paper mills</rdf:li>
     <rdf:li xml:lang="en-US">paper mills</rdf:li>
     <rdf:li xml:lang="x-default">and metadata manipulation. On the basis of this mapped evidence</rdf:li>
     <rdf:li xml:lang="en-US">and metadata manipulation. On the basis of this mapped evidence</rdf:li>
     <rdf:li xml:lang="x-default">we propose a layered conceptual audit combining provenance</rdf:li>
     <rdf:li xml:lang="en-US">we propose a layered conceptual audit combining provenance</rdf:li>
     <rdf:li xml:lang="x-default">targeted detection</rdf:li>
     <rdf:li xml:lang="en-US">targeted detection</rdf:li>
     <rdf:li xml:lang="x-default">bibliographic verification</rdf:li>
     <rdf:li xml:lang="en-US">bibliographic verification</rdf:li>
     <rdf:li xml:lang="x-default">claim-level checking</rdf:li>
     <rdf:li xml:lang="en-US">claim-level checking</rdf:li>
     <rdf:li xml:lang="x-default">and network or metadata analysis. The integrated workflow itself has not yet been empirically validated</rdf:li>
     <rdf:li xml:lang="en-US">and network or metadata analysis. The integrated workflow itself has not yet been empirically validated</rdf:li>
     <rdf:li xml:lang="x-default">and consequential decisions should remain subject to documented human review.</rdf:li>
     <rdf:li xml:lang="en-US">and consequential decisions should remain subject to documented human review.</rdf:li>
    </rdf:Alt>
   </dc:description>
